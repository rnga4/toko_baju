---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ikon from '../components/Ikon.astro';
import SectionJudul from '../components/SectionJudul.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TombolWa from '../components/TombolWa.astro';
import { SITE, linkWa } from '../data/site';

const tautanPesan = linkWa(`Halo ${SITE.nama}. Saya mau bertanya soal produk atau stok.`);

const handleInstagram = '@' + (SITE.mediaSosial.instagram.split('/').filter(Boolean).pop() ?? '').replace(/^@/, '');

const kartuKontak = [
  {
    ikon: 'lokasi' as const,
    judul: 'Alamat store',
    baris: [SITE.alamat, 'Lihat denah via Google Maps'],
    href: 'https://maps.google.com/?q=Cikutra+Baru+Bandung',
  },
  {
    ikon: 'whatsapp' as const,
    judul: 'WhatsApp admin',
    baris: [SITE.telepon, 'Balasan kurang dari 5 menit (jam buka)'],
    href: tautanPesan,
  },
  {
    ikon: 'email' as const,
    judul: 'Email',
    baris: [SITE.email, 'Untuk kerja sama dan grosir'],
    href: `mailto:${SITE.email}`,
  },
  {
    ikon: 'instagram' as const,
    judul: 'Instagram',
    baris: [handleInstagram, 'Tips mix & match setiap malam'],
    href: SITE.mediaSosial.instagram,
  },
];

const pertanyaan = [
  {
    tanya: 'Berapa lama pesanan diproses dan sampai?',
    jawab:
      'Pesanan yang masuk sebelum pukul 14.00 WIB diproses di hari yang sama. Lama pengiriman tergantung tujuan: 2-4 hari untuk pengiriman reguler, 1-2 hari untuk kilat.',
  },
  {
    tanya: 'Bagaimana kalau ukurannya tidak cocok setelah sampai?',
    jawab:
      'Gratis tukar ukuran dalam 7 hari selama label masih utuh dan produk belum dipakai. Ongkir untuk penukaran pertama kami tanggung.',
  },
  {
    tanya: 'Apakah semua produk bisa di COD?',
    jawab:
      'Cek saat checkout atau lewat WhatsApp. COD tersedia untuk area Jabodetabek, Bandung, dan Surabaya dengan nilai maksimal Rp3.000.000.',
  },
  {
    tanya: 'Bisa belanja grosir atau buka reseller?',
    jawab:
      'Bisa. Untuk pembelian di atas 10 pcs, hubungi email grosir kami dan sertakan nama toko atau tujuan jualannya.',
  },
  {
    tanya: 'Apakah ada ruang fitting di store?',
    jawab:
      'Ada. Store buka Senin-Jumat pukul 09.00-20.00 WIB dan Sabtu sampai 17.00 WIB. Minggu libur.',
  },
];
---

<BaseLayout
  judul={`Kontak & Lokasi | ${SITE.namaLengkap} Store`}
  deskripsi={`Hubungi ${SITE.namaLengkap} via WhatsApp, Instagram, atau email. Alamat store di ${SITE.alamat}, buka Senin-Sabtu. Balasan cepat di jam kerja.`}
  path="/kontak"
>
  <div class="wadah pt-6">
    <Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: 'Kontak' }]} />
  </div>

  <section class="wadah py-10 sm:py-14" aria-labelledby="jdl-kontak">
    <SectionJudul
      judul="Gampang dihubungi"
      label="Kontak"
      level={1}
      id="jdl-kontak"
      deskripsi="Pilih saluran yang paling nyaman. Semua dibalas manusia asli, bukan bot."
    />

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        kartuKontak.map((k) => (
          <li>
            <a
              href={k.href}
              target={k.href.startsWith('http') ? '_blank' : undefined}
              rel={k.href.startsWith('http') ? 'noopener me' : undefined}
              class="group flex h-full flex-col rounded-besar border border-sand-200 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-rose-200 hover:shadow-angkat"
            >
              <span class="inline-flex size-11 items-center justify-center rounded-full bg-rose-50 text-rose-700 transition-colors group-hover:bg-rose-700 group-hover:text-white">
                <Ikon nama={k.ikon} kelas="size-5" />
              </span>
              <h2 class="mt-4 font-sans text-[0.9375rem] font-semibold text-sand-900">{k.judul}</h2>
              <p class="mt-1.5 text-sm text-sand-700">{k.baris[0]}</p>
              <p class="mt-1 text-xs text-sand-600">{k.baris[1]}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Peta/Jam -->
  <section class="wadah grid gap-10 pb-20 lg:grid-cols-[1.1fr_1fr] lg:gap-16" aria-label="Lokasi dan jam buka">
    <div>
      <div class="overflow-hidden rounded-besar border border-sand-200 bg-sand-50">
        <iframe
          title={`Peta lokasi ${SITE.namaLengkap} di Cikutra Baru, Bandung`}
          src="https://www.google.com/maps?q=Cikutra%20Baru%20Raya%20Bandung&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="aspect-16/9 w-full"
        ></iframe>
      </div>
      <a
        href="https://maps.google.com/?q=Cikutra+Baru+Bandung"
        target="_blank"
        rel="noopener"
        class="tombol tombol-sekunder mt-6 w-full"
      >
        Buka lokasi di Google Maps
        <Ikon nama="panah" kelas="size-4" />
      </a>
    </div>

    <div class="rounded-besar border border-sand-200 bg-white p-8">
      <h2 class="text-xl font-semibold text-sand-900">Jam buka</h2>
      <dl class="mt-6 divide-y divide-sand-100">
        {
          SITE.jamBuka.map((j) => (
            <div class="flex items-center justify-between py-4">
              <dt class="text-sm font-medium text-sand-800">{j.hari}</dt>
              <dd class="text-sm text-sand-600">{j.jam}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 rounded-xl bg-rose-50 p-4 text-xs leading-relaxed text-rose-800">
        Lebih praktis? Chat admin di WhatsApp sebelum datang supaya stok dan ukuran yang kamu mau sudah
        disiapkan.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-24 bg-sand-50 py-20 sm:py-24" aria-labelledby="jdl-faq-kontak">
    <div class="wadah">
      <SectionJudul
        judul="Sebelum kamu bertanya"
        id="jdl-faq-kontak"
        label="FAQ"
        deskripsi="Lima pertanyaan yang paling sering kami terima."
      />

      <div class="mx-auto mt-12 max-w-3xl divide-y divide-sand-200 rounded-besar border border-sand-200 bg-white px-6">
        {
          pertanyaan.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[0.9375rem] font-semibold text-sand-900 marker:hidden">
                {f.tanya}
                <span class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-rose-50 text-rose-700 transition-transform group-open:rotate-45">
                  <svg viewBox="0 0 24 24" class="size-3.5" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-sand-600">{f.jawab}</p>
            </details>
          ))
        }
      </div>

      <div class="mx-auto mt-10 max-w-3xl rounded-besar bg-rose-900 px-6 py-8 text-center text-rose-50 sm:px-10">
        <h2 class="text-xl text-balance">Masih ragu dengan jawabannya?</h2>
        <p class="mt-2 text-sm text-rose-200">Admin kami siap membantu pilih produk dan cek stok realtime.</p>
        <a href={linkWa('Saya mau bertanya soal produk.')} target="_blank" rel="noopener" class="tombol tombol-terang mt-5">
          <Ikon nama="whatsapp" kelas="size-4" />
          Chat sekarang
        </a>
      </div>
    </div>
  </section>

  <TombolWa />
</BaseLayout>