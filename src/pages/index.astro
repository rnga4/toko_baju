---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ikon from '../components/Ikon.astro';
import SectionJudul from '../components/SectionJudul.astro';
import ProdukCard from '../components/ProdukCard.astro';
import TombolWa from '../components/TombolWa.astro';
import Bintang from '../components/Bintang.astro';
import { SITE, linkWa } from '../data/site';
import { kategori, produkTerlaris } from '../data/produk';
import { alurBelanja, promoAktif, statistik, ulasan } from '../data/konten';
import { tanggalPendek } from '../lib/format';
import { Image } from 'astro:assets';

const unggulan = produkTerlaris[0]!;
const promo = promoAktif[0]!;

const skema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.namaLengkap,
  url: new URL('/', Astro.site ?? 'http://localhost:8095').href,
  inLanguage: 'id-ID',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${new URL('/katalog', Astro.site ?? 'http://localhost:8095').href}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout skema={skema}>
  <!-- ============================ HERO ============================ -->
  <section class="relative overflow-hidden bg-sand-50">
    <div class="pola-anyam absolute inset-0" aria-hidden="true"></div>

    <div class="wadah relative grid items-center gap-12 py-14 lg:grid-cols-2 lg:gap-16 lg:py-20">
      <div class="animate-naik">
        <p class="label bg-rose-100 text-rose-800">
          <span class="size-1.5 rounded-full bg-rose-500" aria-hidden="true"></span>
          Koleksi Gugur 2026 sudah hadir
        </p>

        <h1 class="mt-6 text-[2.25rem] leading-[1.1] text-balance sm:text-[3rem] lg:text-[3.4rem]">
          Busana wanita yang <em class="font-serif italic text-rose-700">mekar</em> bersama gaya Anda.
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-sand-600 sm:text-lg">
          Dress, gamis, blouse, dan outerwear dari bahan yang adem dengan jahitan rapi.
          Harga jelas, tukar gratis, kirim ke seluruh Indonesia.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/katalog" class="tombol tombol-utama">
            Belanja sekarang
            <Ikon nama="panah" kelas="size-4" />
          </a>
          <a href={linkWa()} target="_blank" rel="noopener" class="tombol tombol-sekunder">
            <Ikon nama="whatsapp" kelas="size-4" />
            Chat admin
          </a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-sm animate-masuk lg:mx-0 lg:ml-auto">
        <div class="aspect-4/5 overflow-hidden rounded-besar bg-sand-100 shadow-angkat">
          <Image
            src={unggulan.gambar}
            alt={unggulan.nama}
            widths={[480, 760]}
            sizes="(min-width: 1024px) 24rem, 80vw"
            loading="eager"
            fetchpriority="high"
            class="size-full object-cover"
          />
        </div>

        <div
          class="absolute -bottom-5 -left-4 w-48 rounded-besar border border-sand-200 bg-white/95 p-4 shadow-angkat backdrop-blur sm:-left-6 sm:w-56"
        >
          <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-rose-600 uppercase">
            Terlaris bulan ini
          </p>
          <p class="mt-1.5 font-serif text-lg leading-snug font-semibold text-sand-900">
            {unggulan.nama}
          </p>
          <div class="mt-2">
            <Bintang nilai={unggulan.rating} tampilAngka />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= TRUST STRIP ======================== -->
  <section class="border-y border-sand-200 bg-white" aria-label="Keunggulan belanja">
    <div class="wadah grid grid-cols-2 gap-x-4 gap-y-6 py-7 sm:grid-cols-4">
      {
        statistik.map((s) => (
          <div class="text-center">
            <p class="font-serif text-2xl font-semibold text-rose-800">{s.angka}</p>
            <p class="mt-1 text-xs leading-snug text-sand-600">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- =========================== KATEGORI ========================== -->
  <section class="wadah py-16 sm:py-20" aria-labelledby="jdl-kategori">
    <SectionJudul
      judul="Belanja sesuai kategori"
      id="jdl-kategori"
      label="Koleksi"
      deskripsi="Tujuh kategori favorit, tersedia dalam ukuran S sampai XXL."
    />

    <ul class="mt-8 flex flex-wrap justify-center gap-2.5">
      {
        kategori.map((k) => (
          <li>
            <a
              href={`/katalog/?kategori=${k.slug}`}
              class="inline-flex rounded-full border border-sand-200 bg-white px-5 py-2.5 text-sm font-medium text-sand-700 transition-colors hover:border-rose-300 hover:bg-rose-50 hover:text-rose-800"
            >
              {k.nama}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ========================== PRODUK TERLARIS ==================== -->
  <section class="wadah py-16 sm:py-20" aria-labelledby="jdl-terlaris">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionJudul
        judul="Paling laris bulan ini"
        id="jdl-terlaris"
        label="Terlaris"
        aligns="kiri"
        kelas="max-w-xl"
        deskripsi="Produk yang paling sering dipesan ulang. Tambahkan ke keranjang, checkout sekali."
      />
      <a href="/katalog" class="tombol tombol-sekunder shrink-0">
        Lihat semua
        <Ikon nama="panah" kelas="size-4" />
      </a>
    </div>

    <ul class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
      {
        produkTerlaris.slice(0, 4).map((p, i) => (
          <li>
            <ProdukCard produk={p} prioritas={i < 2} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================= PROMO =========================== -->
  <section class="wadah py-4" aria-label="Promo berjalan">
    <div class="relative overflow-hidden rounded-besar bg-rose-900 p-8 text-rose-50 sm:p-12">
      <div class="tekstur-lin absolute inset-0" aria-hidden="true"></div>
      <div class="relative flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-xl">
          <p class="label bg-champagne-300 text-rose-950">Berlaku {promo.berlaku}</p>
          <h2 class="mt-4 text-2xl leading-tight text-balance sm:text-[1.75rem]">{promo.judul}</h2>
          <p class="mt-3 text-sm leading-relaxed text-rose-200">{promo.sub}</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <code
            class="rounded-xl border border-dashed border-rose-400 px-4 py-2.5 font-mono text-sm font-semibold tracking-wider text-rose-50"
          >
            {promo.kode}
          </code>
          <a href="/katalog" class="tombol tombol-terang">
            Belanja sekarang
            <Ikon nama="panah" kelas="size-4" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ ALUR BELANJA ===================== -->
  <section id="alur" class="scroll-mt-24 bg-sand-900 py-16 text-sand-100 sm:py-20">
    <div class="wadah">
      <SectionJudul
        judul="Empat langkah, selesai"
        label="Cara belanja"
        deskripsi="Tanpa keranjang yang bikin bingung. Pilih, checkout lewat WhatsApp, bayar, sampai."
      />

      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          alurBelanja.map((s) => (
            <li class="relative">
              <span class="font-serif text-[2.75rem] leading-none font-semibold text-rose-400/35">
                {s.langkah}
              </span>
              <h3 class="mt-4 text-lg font-semibold text-sand-50">{s.judul}</h3>
              <p class="mt-2 text-sm leading-relaxed text-sand-400">{s.teks}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================ TESTIMONI ======================== -->
  <section class="wadah py-16 sm:py-20" aria-labelledby="jdl-ulasan">
    <SectionJudul
      judul="Kata mereka yang sudah belanja"
      id="jdl-ulasan"
      label="Ulasan"
      deskripsi="Rata-rata rating 4,9 dari 2.140 ulasan di Instagram dan WhatsApp."
    />

    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {
        ulasan.slice(0, 3).map((u) => (
          <li class="flex h-full flex-col rounded-besar border border-sand-200 bg-white p-6">
            <Bintang nilai={u.rating} />
            <blockquote class="mt-4 flex-1 text-[0.9375rem] leading-relaxed text-sand-700">
              &ldquo;{u.teks}&rdquo;
            </blockquote>
            <footer class="mt-5 flex items-center gap-3 border-t border-sand-100 pt-4">
              <span class="inline-flex size-10 items-center justify-center rounded-full bg-rose-100 text-sm font-semibold text-rose-800">
                {u.inisial}
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-sand-900">{u.nama}</span>
                <span class="block text-xs text-sand-600">
                  {u.kota} &middot; {tanggalPendek(u.tanggal)}
                </span>
              </span>
            </footer>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================ CTA AKHIR ======================== -->
  <section class="wadah py-16 sm:py-20">
    <div class="relative overflow-hidden rounded-besar bg-rose-900 px-6 py-14 text-center text-rose-50 sm:px-12 sm:py-20">
      <div class="pola-anyam absolute inset-0 opacity-70" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-[1.875rem] leading-tight text-balance sm:text-[2.5rem]">
          Sudah siap tampil cantik hari ini?
        </h2>
        <p class="mx-auto mt-4 max-w-lg text-[0.9375rem] leading-relaxed text-rose-200 sm:text-base">
          Tambahkan favoritmu ke keranjang lalu checkout lewat WhatsApp. Gratis ongkir untuk pembelian
          di atas Rp300.000.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="/katalog" class="tombol tombol-terang">Mulai belanja</a>
          <a
            href={SITE.mediaSosial.instagram}
            target="_blank"
            rel="noopener me"
            class="tombol border border-rose-400/60 text-rose-50 transition-colors hover:bg-rose-800"
          >
            <Ikon nama="instagram" kelas="size-4" />
            Lihat Instagram
          </a>
        </div>
      </div>
    </div>
  </section>

  <TombolWa />
</BaseLayout>
