---
interface Props {
  judul: string;
  aligns?: 'kiri' | 'tengah';
  label?: string;
  deskripsi?: string;
  kelas?: string;
  level?: 2 | 3;
}

const { judul, aligns = 'tengah', label, deskripsi, kelas = '', level = 2 } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
---

<div class:list={['max-w-2xl', aligns === 'tengah' && 'mx-auto text-center', kelas]}>
  {
    label && (
      <p class="mb-3 flex items-center gap-2.5 text-[0.6875rem] font-semibold tracking-[0.16em] text-rose-600 uppercase">
        <span class="h-px w-6 bg-rose-300" aria-hidden="true" />
        {label}
        {aligns === 'tengah' && <span class="h-px w-6 bg-rose-300" aria-hidden="true" />}
      </p>
    )
  }
  <Tag class="text-[1.75rem] leading-tight text-balance text-sand-900 sm:text-[2.125rem] lg:text-[2.5rem]">
    {judul}
  </Tag>
  {
    deskripsi && (
      <p class="mt-4 text-[0.9375rem] leading-relaxed text-sand-600 sm:text-base">{deskripsi}</p>
    )
  }
</div>
