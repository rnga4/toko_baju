---
import { SITE, linkWa } from '../data/site';
import Ikon from './Ikon.astro';

interface Props {
  sembunyiSeluler?: boolean;
}

const { sembunyiSeluler = false } = Astro.props;
---

<a
  href={linkWa('Halo Mekar Boutique, saya mau tanya-tanya.')}
  target="_blank"
  rel="noopener"
  class:list={[
    'group fixed right-4 bottom-4 z-40 items-center gap-2.5 rounded-full bg-rose-700 py-3 pr-5 pl-3.5 text-white shadow-angkat transition-colors hover:bg-rose-800 sm:right-6 sm:bottom-6',
    sembunyiSeluler ? 'hidden lg:inline-flex' : 'inline-flex',
  ]}
>
  <span class="relative inline-flex size-8 items-center justify-center rounded-full bg-white/15">
    <Ikon nama="whatsapp" kelas="size-4.5" />
    <span
      class="absolute -inset-1 -z-10 animate-denyut rounded-full bg-rose-700/40 motion-reduce:hidden"
      aria-hidden="true"></span>
  </span>
  <span class="text-sm font-medium">Tanya admin</span>
  <span class="sr-only">Buka percakapan WhatsApp dengan {SITE.namaLengkap}</span>
</a>
