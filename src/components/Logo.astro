---
interface Props {
  kelas?: string;
  ringkas?: boolean;
}

const { kelas = 'size-9', ringkas = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', kelas]}>
  <svg
    viewBox="0 0 40 40"
    class="size-9 shrink-0"
    role="img"
    aria-label="Logo Mekar"
    fill="none"
  >
    <rect width="40" height="40" rx="12" fill="currentColor" class="text-rose-700" />
    <path
      d="M20 30.5c0-6.2 3.6-10.4 9.6-11.6-.3 6.6-3.8 10.6-9.6 11.6Z"
      fill="var(--color-rose-50)"
    />
    <path
      d="M20 30.5c0-6.2-3.6-10.4-9.6-11.6.3 6.6 3.8 10.6 9.6 11.6Z"
      fill="var(--color-champagne-100)"
    />
    <circle cx="20" cy="19.4" r="2.6" fill="var(--color-champagne-100)" />
  </svg>
  {
    !ringkas && (
      <span class="flex flex-col leading-none">
        <span class="font-serif text-[1.35rem] font-semibold tracking-[0.18em] uppercase text-rose-900">
          Mekar
        </span>
        <span class="mt-1 text-[0.55rem] font-medium tracking-[0.34em] uppercase text-rose-400">
          Boutique
        </span>
      </span>
    )
  }
</span>
