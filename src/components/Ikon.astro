---

{
  isi ? (
    <span class={kelas} set:html={isi} />
  ) : fill ? (
    <svg
      class={kelas}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d={fill} />
