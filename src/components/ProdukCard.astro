---
import { Image } from 'astro:assets';
import { hargaTercoret, persenDiskon, type Produk, namaKategori } from '../data/produk';
import { linkWa } from '../data/site';
import { rupiah } from '../lib/format';
import Bintang from './Bintang.astro';

interface Props {
  produk: Produk;
  prioritas?: boolean;
  rasio?: 'potret' | 'persegi';
}

const { produk, prioritas = false, rasio = 'potret' } = Astro.props;

const coret = hargaTercoret(produk);
const diskon = persenDiskon(produk);
const habis = produk.stok === 0;
const menipis = !habis && produk.stok <= 10;

const gayaBadge: Record<string, string> = {
  Baru: 'bg-rose-800 text-white',
  Terlaris: 'bg-champagne-400 text-rose-950',
  Promo: 'bg-sand-900 text-white',
};
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-besar bg-white shadow-lembut transition-shadow duration-300 hover:shadow-angkat">
  <a href={`/produk/${produk.slug}`} class="block" tabindex="-1" aria-hidden="true">
    <div
      class:list={[
        'relative overflow-hidden bg-sand-100',
        rasio === 'persegi' ? 'aspect-square' : 'aspect-4/5',
      ]}
    >
      <Image
        src={produk.gambar}
        alt={produk.nama}
        widths={[320, 480, 640, 900]}
        sizes="(min-width: 1280px) 22rem, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 90vw"
        loading={prioritas ? 'eager' : 'lazy'}
        fetchpriority={prioritas ? 'high' : 'auto'}
        decoding={prioritas ? 'sync' : 'async'}
        class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      />

      <div class="pointer-events-none absolute inset-x-3 top-3 flex flex-wrap items-start gap-1.5">
        {
          produk.badge && (
            <span class:list={['label shadow-sm', gayaBadge[produk.badge] ?? 'bg-rose-800 text-white']}>
              {produk.badge}
            </span>
          )
        }
        {
          diskon > 0 && (
            <span class="label bg-rose-600 text-white shadow-sm">-{diskon}%</span>
          )
        }
      </div>

      {
        habis ? (
          <div class="absolute inset-0 grid place-items-center bg-ink/45 backdrop-blur-[2px]">
            <span class="label bg-white text-ink">Stok habis</span>
          </div>
        ) : menipis ? (
          <span class="label absolute right-3 bottom-3 bg-white/95 text-rose-800 shadow-sm">
            Sisa {produk.stok}
          </span>
        ) : null
      }
    </div>
  </a>

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <p class="text-[0.6875rem] font-medium tracking-[0.12em] text-rose-600 uppercase">
      {namaKategori(produk.kategori)}
    </p>

    <h3 class="mt-1.5 text-[1.0625rem] leading-snug font-semibold text-balance text-sand-900">
      <a
        href={`/produk/${produk.slug}`}
        class="transition-colors after:absolute after:inset-0 hover:text-rose-700"
      >
        {produk.nama}
      </a>
    </h3>

    <p class="mt-1.5 line-clamp-2 text-[0.8125rem] leading-relaxed text-sand-600">
      {produk.ringkas}
    </p>

    <div class="mt-3 flex items-center gap-2">
      <Bintang nilai={produk.rating} />
      <span class="text-xs text-sand-600">({produk.terjual} terjual)</span>
    </div>

    <div class="mt-auto flex flex-col gap-3 pt-4 sm:flex-row sm:items-end sm:justify-between sm:gap-2">
      <div>
        <p class="font-serif text-[1.1875rem] leading-none font-semibold text-rose-800">
          {rupiah(produk.harga)}
        </p>
        {
          coret && (
            <p class="mt-1.5 text-xs text-sand-600 line-through">{rupiah(coret)}</p>
          )
        }
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <a
          href={linkWa(`Halo, saya mau pesan ${produk.nama}.`)}
          target="_blank"
          rel="noopener"
          class="relative z-10 inline-flex size-10 items-center justify-center rounded-full bg-rose-50 text-rose-700 transition-colors hover:bg-rose-700 hover:text-white"
          aria-label={`Pesan ${produk.nama} via WhatsApp`}
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24Zm-2.6 4.2c-.2 0-.53.07-.81.38-.28.31-1.06 1.04-1.06 2.53s1.09 2.94 1.24 3.14c.15.2 2.1 3.2 5.08 4.37.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.12-.28-.2-.59-.35-.31-.15-1.84-.91-2.12-1.01-.28-.11-.49-.16-.7.15-.2.31-.78 1.01-.96 1.21-.18.21-.35.23-.66.08-.31-.15-1.3-.48-2.47-1.53a9.3 9.3 0 0 1-1.72-2.14c-.18-.31 0-.48.13-.63.14-.14.31-.35.46-.53.16-.18.21-.31.31-.51.1-.21.05-.39-.02-.54-.08-.15-.7-1.68-.95-2.3-.25-.6-.5-.52-.7-.53h-.6Z"
            ></path>
          </svg>
        </a>

        <button
          type="button"
          data-tambah-keranjang
          data-slug={produk.slug}
          data-nama={produk.nama}
          data-harga={produk.harga}
          data-gambar={produk.gambar.src}
          class="relative z-10 inline-flex size-10 items-center justify-center rounded-full bg-rose-700 text-white transition-colors hover:bg-rose-800"
          aria-label={`Tambah ${produk.nama} ke keranjang`}
          title="Tambah ke keranjang"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3.5 4.5h2.2l2.4 10.2h9.4l2.2-7.4H7M9.5 20a1.3 1.3 0 1 0 0-2.6 1.3 1.3 0 0 0 0 2.6Zm7 0a1.3 1.3 0 1 0 0-2.6 1.3 1.3 0 0 0 0 2.6Z" />
            <path d="M14.5 6.5v4M12.5 8.5h4" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</article>
