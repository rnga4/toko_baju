---
interface Props {
  nilai: number;
  ukuran?: 'sm' | 'md';
  tampilAngka?: boolean;
}

const { nilai, ukuran = 'sm', tampilAngka = false } = Astro.props;
const bulat = Math.round(nilai);
const kelasBintang = ukuran === 'sm' ? 'size-3.5' : 'size-4';
const kelasAngka = ukuran === 'sm' ? 'text-xs' : 'text-sm';
---

<span class="inline-flex items-center gap-1.5">
  <span class="inline-flex text-champagne-500" role="img" aria-label={`Rating ${nilai} dari 5`}>
    {
      Array.from({ length: 5 }, (_, i) => (
        <svg
          viewBox="0 0 24 24"
          class:list={[
            kelasBintang,
            i < bulat ? 'fill-current' : 'fill-transparent stroke-current/35',
          ]}
          stroke-width="1.4"
          aria-hidden="true"
        >
          <path
            d="M12 3.6l2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.8l5.9-.8L12 3.6Z"
          />
        </svg>
      ))
    }
  </span>
  {
    tampilAngka && (
      <span class:list={['font-medium text-sand-600', kelasAngka]}>{nilai.toFixed(1).replace('.', ',')}</span>
    )
  }
</span>
