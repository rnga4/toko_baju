---
import { SITE } from '../data/site';
import Ikon from './Ikon.astro';
---

<div
  class="fixed inset-0 z-[70] hidden"
  data-keranjang-root
  data-wa={SITE.whatsapp}
  data-brand={SITE.namaLengkap}
>
  <button
    type="button"
    data-keranjang-tutup
    aria-label="Tutup keranjang"
    class="absolute inset-0 h-full w-full cursor-default bg-ink/40 opacity-0 transition-opacity duration-300"
    data-keranjang-backdrop
  >
  </button>

  <aside
    role="dialog"
    aria-modal="true"
    aria-label="Keranjang belanja"
    class="absolute top-0 right-0 flex h-full w-full max-w-md translate-x-full flex-col bg-kertas shadow-angkat transition-transform duration-300 ease-out"
    data-keranjang-panel
  >
    <header class="flex items-center justify-between border-b border-sand-200 px-5 pt-[max(1rem,env(safe-area-inset-top))] pb-4">
      <h2 class="flex items-center gap-2 font-serif text-xl text-sand-900">
        <Ikon nama="keranjang" kelas="size-5 text-rose-700" />
        Keranjang
      </h2>
      <button
        type="button"
        data-keranjang-tutup
        class="inline-flex size-10 items-center justify-center rounded-full text-sand-700 transition-colors hover:bg-sand-100"
        aria-label="Tutup keranjang"
      >
        <Ikon nama="tutup" kelas="size-5" />
      </button>
    </header>

    <div class="flex-1 overflow-y-auto overscroll-contain px-5" data-keranjang-isi></div>

    <div class="border-t border-sand-200 p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]" data-keranjang-kaki>
      <div class="flex items-center justify-between">
        <span class="text-sm text-sand-600">Total</span>
        <span class="font-serif text-2xl font-semibold text-rose-800" data-keranjang-total>Rp0</span>
      </div>
      <a href="#" data-keranjang-checkout class="tombol tombol-utama mt-4 w-full">
        <Ikon nama="whatsapp" kelas="size-4" />
        Checkout via WhatsApp
      </a>
      <p class="mt-2 text-center text-xs text-sand-600">
        Pesanan dikonfirmasi admin lewat WhatsApp. Data tersimpan di perangkat ini.
      </p>
    </div>
  </aside>
</div>

<script>
  interface Item {
    slug: string;
    nama: string;
    harga: number;
    gambar: string;
    varian?: string;
    qty: number;
  }

  const KUNCI = 'keranjang';
  const root = document.querySelector<HTMLElement>('[data-keranjang-root]');
  if (root) {
    const panel = root.querySelector<HTMLElement>('[data-keranjang-panel]');
    const backdrop = root.querySelector<HTMLElement>('[data-keranjang-backdrop]');
    const isi = root.querySelector<HTMLElement>('[data-keranjang-isi]');
    const totalEl = root.querySelector<HTMLElement>('[data-keranjang-total]');
    const checkout = root.querySelector<HTMLAnchorElement>('[data-keranjang-checkout]');
    const wa = root.dataset.wa ?? '';
    const brand = root.dataset.brand ?? '';

    const rp = (n: number) => 'Rp' + new Intl.NumberFormat('id-ID').format(n);
    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    let daftar: Item[] = [];
    try {
      daftar = JSON.parse(localStorage.getItem(KUNCI) ?? '[]') as Item[];
      if (!Array.isArray(daftar)) daftar = [];
    } catch {
      daftar = [];
    }

    const simpan = () => {
      try {
        localStorage.setItem(KUNCI, JSON.stringify(daftar));
      } catch {
        /* abaikan */
      }
    };

    const jumlahTotal = () => daftar.reduce((n, it) => n + it.qty, 0);

    // Ikon kecil untuk tombol qty/hapus (agar tidak perlu komponen di dalam JS).
    const svgKurang = '<svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5.5 12h13"/></svg>';
    const svgTambah = '<svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5.5v13M5.5 12h13"/></svg>';
    const svgHapus = '<svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 7h15M9.5 7V5.6c0-.6.5-1.1 1.1-1.1h2.8c.6 0 1.1.5 1.1 1.1V7m-7.6 0 .7 11.9c0 .9.7 1.6 1.6 1.6h4.6c.9 0 1.6-.7 1.6-1.6L16.5 7"/></svg>';

    const render = () => {
      document.querySelectorAll<HTMLElement>('[data-keranjang-jumlah]').forEach((b) => {
        b.textContent = String(jumlahTotal());
        b.hidden = jumlahTotal() === 0;
      });

      if (!isi || !totalEl || !checkout) return;

      if (daftar.length === 0) {
        isi.innerHTML = `
          <div class="flex h-full flex-col items-center justify-center py-16 text-center">
            <span class="inline-flex size-14 items-center justify-center rounded-full bg-sand-100 text-sand-500">
              <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 4.5h2.2l2.4 10.2h9.4l2.2-7.4H7M9.5 20a1.3 1.3 0 1 0 0-2.6 1.3 1.3 0 0 0 0 2.6Zm7 0a1.3 1.3 0 1 0 0-2.6 1.3 1.3 0 0 0 0 2.6Z"/></svg>
            </span>
            <p class="mt-4 font-serif text-lg text-sand-900">Keranjang masih kosong</p>
            <p class="mt-1 max-w-xs text-sm text-sand-600">Yuk pilih koleksi favoritmu dulu, lalu checkout sekali lewat WhatsApp.</p>
            <a href="/katalog" class="tombol tombol-utama mt-5">Lihat katalog</a>
          </div>`;
        totalEl.textContent = rp(0);
        checkout.setAttribute('aria-disabled', 'true');
        checkout.classList.add('pointer-events-none', 'opacity-50');
        return;
      }

      checkout.removeAttribute('aria-disabled');
      checkout.classList.remove('pointer-events-none', 'opacity-50');

      isi.innerHTML =
        `<ul class="divide-y divide-sand-100">` +
        daftar
          .map(
            (it) => `
          <li class="flex gap-3 py-4" data-item="${esc(it.slug)}">
            <img src="${esc(it.gambar)}" alt="" width="64" height="80" loading="lazy"
              class="h-20 w-16 shrink-0 rounded-lg bg-sand-100 object-cover" />
            <div class="flex min-w-0 flex-1 flex-col">
              <div class="flex items-start gap-2">
                <p class="min-w-0 flex-1 text-sm font-medium text-sand-900">
                  ${esc(it.nama)}
                  ${it.varian ? `<span class="mt-0.5 block text-xs font-normal text-sand-600">${esc(it.varian)}</span>` : ''}
                </p>
                <button type="button" data-item-hapus
                  class="inline-flex size-8 shrink-0 items-center justify-center rounded-full text-sand-500 transition-colors hover:bg-sand-100 hover:text-rose-700"
                  aria-label="Hapus ${esc(it.nama)}">${svgHapus}</button>
              </div>
              <p class="mt-0.5 text-sm font-semibold text-rose-800">${rp(it.harga)}</p>
              <div class="mt-auto flex items-center justify-between gap-2 pt-2">
                <div class="inline-flex items-center rounded-full border border-sand-200">
                  <button type="button" data-item-kurang aria-label="Kurangi jumlah"
                    class="inline-flex size-8 items-center justify-center rounded-full text-sand-700 transition-colors hover:bg-sand-100">${svgKurang}</button>
                  <span class="w-8 text-center text-sm tabular-nums text-sand-800">${it.qty}</span>
                  <button type="button" data-item-tambah aria-label="Tambah jumlah"
                    class="inline-flex size-8 items-center justify-center rounded-full text-sand-700 transition-colors hover:bg-sand-100">${svgTambah}</button>
                </div>
                <span class="text-xs text-sand-600">Subtotal ${rp(it.harga * it.qty)}</span>
              </div>
            </div>
          </li>`,
          )
          .join('') +
        `</ul>`;

      const total = daftar.reduce((n, it) => n + it.harga * it.qty, 0);
      totalEl.textContent = rp(total);

      const baris = daftar.map((it, i) => `${i + 1}. ${it.nama}${it.varian ? ` (${it.varian})` : ''} x${it.qty} = ${rp(it.harga * it.qty)}`);
      const teks = `Halo ${brand}, saya mau pesan:\n${baris.join('\n')}\n\nTotal: ${rp(total)}\nMohon info ketersediaan, ukuran, dan ongkirnya ya.`;
      checkout.href = `https://wa.me/${wa}?text=${encodeURIComponent(teks)}`;
    };

    const buka = () => {
      root.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        panel?.classList.remove('translate-x-full');
        backdrop?.classList.remove('opacity-0');
      });
    };
    const tutup = () => {
      panel?.classList.add('translate-x-full');
      backdrop?.classList.add('opacity-0');
      document.body.style.removeProperty('overflow');
      window.setTimeout(() => root.classList.add('hidden'), 300);
    };

    root.querySelectorAll('[data-keranjang-tutup]').forEach((el) => el.addEventListener('click', tutup));
    document
      .querySelectorAll('[data-keranjang-tombol]')
      .forEach((el) => el.addEventListener('click', buka));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root.classList.contains('hidden')) tutup();
    });

    const tambah = (item: Omit<Item, 'qty'>, qty = 1) => {
      const ada = daftar.find((it) => it.slug === item.slug && (it.varian ?? '') === (item.varian ?? ''));
      if (ada) ada.qty += qty;
      else daftar.push({ ...item, qty });
      simpan();
      render();
      buka();
    };

    // Tombol "Tambah ke keranjang" di seluruh situs.
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-tambah-keranjang]');
      if (!btn) return;
      e.preventDefault();
      const { slug, nama, harga, gambar, varian } = btn.dataset;
      if (!slug || !nama) return;
      tambah({ slug, nama, harga: Number(harga) || 0, gambar: gambar ?? '', varian: varian || undefined });
    });

    // Kontrol di dalam panel.
    isi?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const li = target?.closest<HTMLElement>('[data-item]');
      if (!li) return;
      const slug = li.dataset.item;
      const it = daftar.find((x) => x.slug === slug);
      if (!it) return;
      if (target?.closest('[data-item-tambah]')) it.qty += 1;
      else if (target?.closest('[data-item-kurang]')) it.qty = Math.max(1, it.qty - 1);
      else if (target?.closest('[data-item-hapus]')) daftar = daftar.filter((x) => x.slug !== slug);
      else return;
      simpan();
      render();
    });

    render();
  }
</script>
