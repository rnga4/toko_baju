---
interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav aria-label="Remah roti">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-sand-600">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {item.href ? (
            <a href={item.href} class="transition-colors hover:text-rose-700">
              {item.label}
            </a>
          ) : (
            <span class="text-sand-700" aria-current="page">
              {item.label}
            </span>
          )}
          {i < items.length - 1 && <span aria-hidden="true" class="text-sand-500">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
