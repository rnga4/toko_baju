# Salin ke .env lalu sesuaikan. Semua variabel punya default (aman tanpa .env).

# URL publik yang dipakai untuk canonical/OG/sitemap.
SITE_URL=http://localhost:8095

# Port publik yang dibind proxy di host (jangan bentrok dengan service lain).
PUBLIC_HTTP_PORT=8095

# Opsional: port HTTPS di host bila 443 dipakai service lain.
# PUBLIC_HTTPS_PORT=8443

# Untuk profile `tunnel`: isi token Zero Trust Tunnel dari Cloudflare dashboard.
# TUNNEL_TOKEN=